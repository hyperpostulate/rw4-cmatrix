<template>
  <div class="app">
    <div class="col" for="{{ grid }}">
      <image class="cell" for="{{ $item }}" src="{{ $item }}"></image>
    </div>
  </div>
</template>

<script>
// cmatrix clone for the Redmi Watch 4 (Vela quick app).
//
// Device notes:
//   - <text>/<span>/<input> paint no readable glyphs on this watch and bundled
//     @font-face has no effect, so every character is a pre-rendered PNG from a
//     glyph atlas generated by scripts/gen_assets.py:
//       /common/txt/g_<codepoint-hex>_<shade>.png  (hex is lowercase, shade 0..1)
//       /common/txt/blank.png                      (empty cell)
//   - The grid geometry is fixed and its data arrays are stable: they are
//     built once in onInit and never reassigned. Data is COLUMN-major: a
//     falling column's per-tick changes (new head, shade flip, tail exit)
//     all land in that column's own array, so one full-range splice per
//     changed column batches them into a single update event (row-major
//     scattered them across ~all rows and cost one re-render each).
//     In-place `arr[i] = x` is not observable in Vue-style frameworks.
//     On-device measurements: full reassign ~7-8 s/frame, per-cell splice
//     ~3-4 s, per-array splice ~2 s (row-major) - the cost unit is the
//     list re-render, not the changed cell.
//   - Perf warning: the full grid is hundreds of <image> elements. Keeping
//     COLS*ROWS small is what makes this usable on the watch; growing either
//     dimension visibly slows rendering.
//   - TUNING constants below are meant to be adjusted on-device, not guessed.
//   - Vela supports only flex-direction + margin/padding for layout (no
//     display/gap), hence the row/column flex wrappers.

// ---- TUNING ---------------------------------------------------------------
const COLS = 18           // 18 * 20px = 360px wide; the right edge rests black
const ROWS = 17           // 17 * 26px = 442px tall
const CELL_W = 20         // must match .cell width
const CELL_H = 26         // must match .cell height
const TICK_MS = 500       // animation interval
const TRAIL_MIN = 6       // shortest visible tail (cells)
const TRAIL_MAX = 14      // longest visible tail (cells)
const SPEED_MIN = 0.2     // cells advanced per tick (slow)
const SPEED_MAX = 0.4     // cells advanced per tick (fast)
const WAIT_MAX = 25       // max ticks a column idles before restarting
const MUTATE_CHANCE = 0.05 // chance a trail cell glyph changes per tick
const KANA_WEIGHT = 0.7   // share of glyphs drawn from halfwidth katakana
// ---------------------------------------------------------------------------

// Halfwidth katakana: U+FF66..U+FF9D.
const KANA_START = 0xFF66
const KANA_END = 0xFF9D
const LATIN = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$+-*=<>'

const BLANK = '/common/txt/blank.png'

function randInt(min, max) {
  return min + Math.floor(Math.random() * (max - min + 1))
}

function rand(min, max) {
  return min + Math.random() * (max - min)
}

function pickChar() {
  if (Math.random() < KANA_WEIGHT) {
    return randInt(KANA_START, KANA_END)
  }
  return LATIN.charCodeAt(randInt(0, LATIN.length - 1))
}

function srcOf(cp, shade) {
  return '/common/txt/g_' + cp.toString(16) + '_' + shade + '.png'
}

function makeChars() {
  // Avoid Array.prototype.fill: not guaranteed on every Vela JS engine.
  const chars = []
  for (let r = 0; r < ROWS; r++) {
    chars.push(0)
  }
  return chars
}

function makeColumn() {
  return { head: -1, trail: TRAIL_MIN, speed: 1, acc: 0, wait: 0, chars: makeChars() }
}

export default {
  private: {
    grid: []
  },

  onInit() {
    this._timer = null
    this._cols = []

    for (let c = 0; c < COLS; c++) {
      const col = makeColumn()
      col.trail = randInt(TRAIL_MIN, TRAIL_MAX)
      col.speed = rand(SPEED_MIN, SPEED_MAX)
      col.chars = makeChars()

      // Some columns start idle (empty) so the screen does not fill at once.
      col.wait = Math.random() < 0.3 ? randInt(1, WAIT_MAX) : 0

      if (col.wait > 0) {
        col.head = -1
      } else {
        // Scatter heads vertically; fill the rows already passed by the head.
        col.head = randInt(-TRAIL_MAX, ROWS)
        const filled = Math.min(col.head, ROWS - 1)
        for (let r = 0; r <= filled; r++) {
          col.chars[r] = pickChar()
        }
      }

      this._cols.push(col)
    }

    // Build the first frame immediately (never open on a blank screen).
    this._buildGrid()
  },

  onShow() {
    if (!this._timer) {
      this._timer = setInterval(() => this._tick(), TICK_MS)
    }
  },

  onHide() {
    this._stopTimer()
  },

  onDestroy() {
    this._stopTimer()
  },

  _stopTimer() {
    if (this._timer) {
      clearInterval(this._timer)
      this._timer = null
    }
  },

  _restart(col) {
    col.head = -1
    col.acc = 0
    col.trail = randInt(TRAIL_MIN, TRAIL_MAX)
    col.speed = rand(SPEED_MIN, SPEED_MAX)
    col.chars = makeChars()
  },

  _tick() {
    if (!this._cols || !this._cols.length) {
      return
    }

    // 1. Advance every column's head; respawn finished columns after a wait.
    for (let c = 0; c < this._cols.length; c++) {
      const col = this._cols[c]

      if (col.wait > 0) {
        col.wait--
        if (col.wait === 0) {
          this._restart(col)
        }
        continue
      }

      col.acc += col.speed
      while (col.acc >= 1) {
        col.acc -= 1
        col.head++
        if (col.head >= 0 && col.head < ROWS) {
          col.chars[col.head] = pickChar()
        }
      }

      if (col.head - col.trail >= ROWS) {
        col.wait = randInt(0, WAIT_MAX)
      }
    }

    // 2. Mutation: randomly re-roll glyphs in visible trail cells (cmatrix's
    //    flickering characters).
    for (let c = 0; c < this._cols.length; c++) {
      const col = this._cols[c]
      if (col.wait !== 0 || col.head < 0) {
        continue
      }
      if (Math.random() < MUTATE_CHANCE) {
        const d = randInt(0, col.trail)
        const r = col.head - d
        if (r >= 0 && r < ROWS) {
          col.chars[r] = pickChar()
        }
      }
    }

    this._updateGrid()
  },

  // Incremental frame update, one mutation event per changed column: a
  // column's whole content is replaced with a single full-range splice on
  // the SAME array (no fresh reference - a fresh array reference re-sets all
  // of the list's cells). Columns without changes cost nothing.
  _updateGrid() {
    for (let c = 0; c < COLS; c++) {
      const col = this._cols[c]
      // Read the column through the data getter every tick: if the framework
      // wrapped the arrays in observers, this is the observed instance.
      const colArr = this.grid[c]
      const vals = []
      let changed = false

      for (let r = 0; r < ROWS; r++) {
        const d = col.head - r

        let src
        if (col.wait > 0 || d < 0 || d > col.trail) {
          src = BLANK
        } else {
          // Bright white-ish head on a uniform green body.
          const shade = d === 0 ? 0 : 1

          let cp = col.chars[r]
          if (!cp) {
            cp = pickChar()
            col.chars[r] = cp
          }

          src = srcOf(cp, shade)
        }

        // Strings compare by value: freshly built equal srcs are not changes.
        vals.push(src)
        if (colArr[r] !== src) {
          changed = true
        }
      }

      if (changed) {
        // splice.apply keeps the mutation to ONE observed call even where
        // spread syntax in calls is not guaranteed on the Vela JS engine.
        const args = [0, ROWS].concat(vals)
        colArr.splice.apply(colArr, args)
      }
    }
  },

  // First frame, column-major: grid[c][r] is the src of cell (row r, col c).
  _buildGrid() {
    const grid = []

    for (let c = 0; c < COLS; c++) {
      const col = this._cols[c]
      const colArr = []

      for (let r = 0; r < ROWS; r++) {
        const d = col.head - r

        if (col.wait > 0 || d < 0 || d > col.trail) {
          colArr.push(BLANK)
          continue
        }

        // Bright white-ish head on a uniform green body.
        const shade = d === 0 ? 0 : 1

        let cp = col.chars[r]
        if (!cp) {
          cp = pickChar()
          col.chars[r] = cp
        }

        colArr.push(srcOf(cp, shade))
      }

      grid.push(colArr)
    }

    this.grid = grid
  }
}
</script>

<style>
.app {
  width: 390px;
  height: 450px;
  flex-direction: row;
  align-items: flex-start;
  background-color: #000000;
  padding-left: 5px;
  padding-top: 4px;
}

.col {
  flex-direction: column;
}

.cell {
  width: 20px;
  height: 26px;
}
</style>
