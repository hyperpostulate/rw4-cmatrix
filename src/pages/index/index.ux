<template>
  <div class="app">
    <canvas id="cv" class="cv" if="{{ !fallback }}"></canvas>
    <div class="grid" if="{{ fallback }}">
      <div class="row" for="{{ grid }}">
        <image class="cell" for="{{ $item }}" src="{{ $item }}"></image>
      </div>
    </div>
  </div>
</template>

<script>
// cmatrix clone for the Redmi Watch 4 (Vela quick app).
//
// Rendering is dual-mode:
//   - Canvas probe mode (preferred): one <canvas> node is painted with
//     fillRect + drawImage from a glyph atlas. The canvas is accessed via
//     this.$element('cv') in onShow (there is no $refs API and nodes only
//     exist after onReady), sized only by CSS, and cleared with a black
//     fillRect on every frame (clearRect would expose the canvas's default
//     WHITE background). Images come from the global Image constructor and
//     are drawn only after img.onload sets img._ok. Coordinates stay
//     integers because Vela runs integer arithmetic on wearables.
//   - Image-grid fallback: if any part of the canvas probe fails (missing
//     node, getContext, fillRect/drawImage or the Image global), the app
//     flips this.fallback and the original fixed <image> grid renders
//     instead. In canvas mode this.grid is never touched after onInit, so
//     there is no data-driven re-render of the template.
//
// Device notes:
//   - <text>/<span>/<input> paint no readable glyphs on this watch and bundled
//     @font-face has no effect, so every character is a pre-rendered PNG from a
//     glyph atlas generated by scripts/gen_assets.py:
//       /common/txt/g_<codepoint-hex>_<shade>.png  (hex is lowercase, shade 0..1)
//       /common/txt/blank.png                      (empty cell)
//   - Perf warning: the full fallback grid is hundreds of <image> elements.
//     Canvas mode replaces them with a single node plus cached bitmaps.
//   - TUNING constants below are meant to be adjusted on-device, not guessed.
//   - Vela supports only flex-direction + margin/padding for layout (no
//     display/gap), hence the row/column flex wrappers.

// ---- TUNING ---------------------------------------------------------------
const COLS = 15           // 15 * 26px = 390px wide
const ROWS = 14           // 14 * 32px = 448px tall
const CELL_W = 26         // must match .cell width
const CELL_H = 32         // must match .cell height
const TICK_MS = 240       // animation interval
const TRAIL_MIN = 5       // shortest visible tail (cells)
const TRAIL_MAX = 11      // longest visible tail (cells)
const SPEED_MIN = 1.0     // cells advanced per tick (slow)
const SPEED_MAX = 2.2     // cells advanced per tick (fast)
const WAIT_MAX = 25       // max ticks a column idles before restarting
const MUTATE_CHANCE = 0.2 // chance a trail cell glyph changes per tick
const KANA_WEIGHT = 0.7   // share of glyphs drawn from halfwidth katakana
const CANVAS_W = 390      // canvas CSS width  (= COLS * CELL_W)
const CANVAS_H = 448      // canvas CSS height (= ROWS * CELL_H)
const DIAG_TICKS = 5      // ticks the green diagnosis strip stays visible
const DIAG_COLOR = '#00C853'
const DIAG_H = 8          // diagnosis strip height in px
// ---------------------------------------------------------------------------

// Halfwidth katakana: U+FF66..U+FF9D.
const KANA_START = 0xFF66
const KANA_END = 0xFF9D
const LATIN = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$+-*=<>'

const BLANK = '/common/txt/blank.png'

function randInt(min, max) {
  return min + Math.floor(Math.random() * (max - min + 1))
}

function rand(min, max) {
  return min + Math.random() * (max - min)
}

function pickChar() {
  if (Math.random() < KANA_WEIGHT) {
    return randInt(KANA_START, KANA_END)
  }
  return LATIN.charCodeAt(randInt(0, LATIN.length - 1))
}

function srcOf(cp, shade) {
  return '/common/txt/g_' + cp.toString(16) + '_' + shade + '.png'
}

function makeChars() {
  // Avoid Array.prototype.fill: not guaranteed on every Vela JS engine.
  const chars = []
  for (let r = 0; r < ROWS; r++) {
    chars.push(0)
  }
  return chars
}

function makeColumn() {
  return { head: -1, trail: TRAIL_MIN, speed: 1, acc: 0, wait: 0, chars: makeChars() }
}

export default {
  private: {
    grid: [],
    fallback: false
  },

  onInit() {
    this._timer = null
    this._ticks = 0
    this._ctx = null
    this._imgCache = null
    this._modeDecided = false
    this._cols = []

    for (let c = 0; c < COLS; c++) {
      const col = makeColumn()
      col.trail = randInt(TRAIL_MIN, TRAIL_MAX)
      col.speed = rand(SPEED_MIN, SPEED_MAX)
      col.chars = makeChars()

      // Some columns start idle (empty) so the screen does not fill at once.
      col.wait = Math.random() < 0.3 ? randInt(1, WAIT_MAX) : 0

      if (col.wait > 0) {
        col.head = -1
      } else {
        // Scatter heads vertically; fill the rows already passed by the head.
        col.head = randInt(-TRAIL_MAX, ROWS)
        const filled = Math.min(col.head, ROWS - 1)
        for (let r = 0; r <= filled; r++) {
          col.chars[r] = pickChar()
        }
      }

      this._cols.push(col)
    }

    // Build the first frame immediately (never open on a blank screen).
    // Also gives fallback mode a frame in case the canvas probe fails.
    this._buildGrid()
  },

  onShow() {
    if (!this._timer) {
      if (!this._modeDecided) {
        this._modeDecided = true
        this._startCanvas()
      }
      this._timer = setInterval(() => this._tick(), TICK_MS)
    }
  },

  onHide() {
    this._stopTimer()
  },

  onDestroy() {
    this._stopTimer()
  },

  _stopTimer() {
    if (this._timer) {
      clearInterval(this._timer)
      this._timer = null
    }
  },

  // Probe the canvas API exactly once. Any missing piece of the pipeline
  // throws and flips the app to the image-grid renderer for good.
  _startCanvas() {
    try {
      const cv = this.$element('cv')
      if (!cv) {
        throw new Error('no canvas node')
      }
      if (typeof cv.getContext !== 'function') {
        throw new Error('no getContext')
      }

      const ctx = cv.getContext('2d')
      if (!ctx) {
        throw new Error('no 2d context')
      }
      if (typeof ctx.fillRect !== 'function' || typeof ctx.drawImage !== 'function') {
        throw new Error('incomplete 2d context')
      }

      // Glyph drawing is impossible without the global Image constructor.
      if (typeof Image !== 'function') {
        throw new Error('no Image global')
      }

      this._ctx = ctx
      this._imgCache = {}
      this._ticks = 0

      // Preload blank.png as a pipeline check (informational only: the mode
      // is never gated on it).
      const probe = new Image()
      probe.onload = () => { probe._ok = true }
      probe.onerror = () => {}
      probe.src = BLANK
    } catch (e) {
      this._useFallback()
    }
  },

  _useFallback() {
    // this.grid already holds a frame from onInit, so the template can switch
    // to the image grid without an extra render.
    this.fallback = true
  },

  _restart(col) {
    col.head = -1
    col.acc = 0
    col.trail = randInt(TRAIL_MIN, TRAIL_MAX)
    col.speed = rand(SPEED_MIN, SPEED_MAX)
    col.chars = makeChars()
  },

  _tick() {
    if (!this._cols || !this._cols.length) {
      return
    }

    // 1. Advance every column's head; respawn finished columns after a wait.
    for (let c = 0; c < this._cols.length; c++) {
      const col = this._cols[c]

      if (col.wait > 0) {
        col.wait--
        if (col.wait === 0) {
          this._restart(col)
        }
        continue
      }

      col.acc += col.speed
      while (col.acc >= 1) {
        col.acc -= 1
        col.head++
        if (col.head >= 0 && col.head < ROWS) {
          col.chars[col.head] = pickChar()
        }
      }

      if (col.head - col.trail >= ROWS) {
        col.wait = randInt(0, WAIT_MAX)
      }
    }

    // 2. Mutation: randomly re-roll glyphs in visible trail cells (cmatrix's
    //    flickering characters).
    for (let c = 0; c < this._cols.length; c++) {
      const col = this._cols[c]
      if (col.wait !== 0 || col.head < 0) {
        continue
      }
      if (Math.random() < MUTATE_CHANCE) {
        const d = randInt(0, col.trail)
        const r = col.head - d
        if (r >= 0 && r < ROWS) {
          col.chars[r] = pickChar()
        }
      }
    }

    this._render()
    this._ticks++
  },

  _render() {
    if (this._ctx) {
      this._renderCanvas()
    } else {
      this._buildGrid()
    }
  },

  _renderCanvas() {
    // clearRect would expose the canvas's default WHITE background; a black
    // fillRect is the only safe way to clear a frame.
    this._ctx.fillStyle = '#000000'
    this._ctx.fillRect(0, 0, CANVAS_W, CANVAS_H)

    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const col = this._cols[c]
        const d = col.head - r

        if (col.wait > 0 || d < 0 || d > col.trail) {
          continue
        }

        // Bright white-ish head on a uniform green body.
        const shade = d === 0 ? 0 : 1

        let cp = col.chars[r]
        if (!cp) {
          cp = pickChar()
          col.chars[r] = cp
        }

        const img = this._glyph(srcOf(cp, shade))
        if (img._ok) {
          this._ctx.drawImage(img, c * CELL_W, r * CELL_H, CELL_W, CELL_H)
        }
      }
    }

    // Diagnosis aid: a green strip at the bottom for the first few ticks.
    // Visible strip = canvas pipeline works on-device. Absent with a black
    // screen = the canvas API exists but renders nothing.
    if (this._ticks < DIAG_TICKS) {
      this._ctx.fillStyle = DIAG_COLOR
      this._ctx.fillRect(0, CANVAS_H - DIAG_H, CANVAS_W, DIAG_H)
    }
  },

  _glyph(src) {
    let img = this._imgCache[src]
    if (!img) {
      img = new Image()
      img._ok = false
      img.onload = () => { img._ok = true }
      img.onerror = () => {}
      img.src = src
      this._imgCache[src] = img
    }
    return img
  },

  _buildGrid() {
    const grid = []

    for (let r = 0; r < ROWS; r++) {
      const row = []

      for (let c = 0; c < COLS; c++) {
        const col = this._cols[c]
        const d = col.head - r

        if (col.wait > 0 || d < 0 || d > col.trail) {
          row.push(BLANK)
          continue
        }

        // Bright white-ish head on a uniform green body.
        const shade = d === 0 ? 0 : 1

        let cp = col.chars[r]
        if (!cp) {
          cp = pickChar()
          col.chars[r] = cp
        }

        row.push(srcOf(cp, shade))
      }

      grid.push(row)
    }

    this.grid = grid
  }
}
</script>

<style>
.app {
  width: 390px;
  height: 450px;
  flex-direction: column;
  align-items: flex-start;
  background-color: #000000;
  padding-left: 0px;
  padding-top: 2px;
}

.grid {
  width: 390px;
  flex-direction: column;
  align-items: flex-start;
}

.cv {
  width: 390px;
  height: 448px;
}

.row {
  flex-direction: row;
}

.cell {
  width: 26px;
  height: 32px;
}
</style>
